# Default = Maja, existing database
VITE_SITE_ID=sppg-maja-gpt-site
VITE_FIRESTORE_DATABASE_ID=(default)
VITE_SITE_LABEL=SPPG MAJA BARU
VITE_SITE_SHORT_LABEL=Maja

# Pusat Operasional / SPPG Core API
VITE_SPPG_CORE_API_URL=

# Backend SPPG Core
DATABASE_URL=
SPPG_ALLOWED_ORIGINS=

# Login aplikasi SPPG (bukan akun ChatGPT).
SPPG_AUTH_SECRET=
SPPG_OWNER_PASSWORD=
SPPG_MAJA_PASSWORD=
SPPG_CEMPLANG_PASSWORD=

# Final role destinations:
# OWNER: kedua kalkulator + operations + kedua accountant.
# MAJA/CEMPLANG: hanya kalkulator masing-masing.
SPPG_MAJA_CALCULATOR_URL=
SPPG_CEMPLANG_CALCULATOR_URL=

# Kalkulator lama sekarang disajikan langsung dari service Railway yang sama.
# URL di atas opsional; tanpa override otomatis memakai /dapur/maja dan /dapur/cemplang.
SPPG_MAJA_CALCULATOR_DATABASE_ID=(default)
SPPG_CEMPLANG_CALCULATOR_DATABASE_ID=cemplang2
SPPG_FIREBASE_PUBLIC_CONFIG_JSON=

# Optional but recommended: pin direct Kalkulator -> Firestore sync to one appId.
# Without these, the bridge discovers artifacts/*/public/data/dailyPlans and refuses
# to guess if multiple calculator appIds contain the same distribution date.
SPPG_MAJA_CALCULATOR_APP_ID=
SPPG_CEMPLANG_CALCULATOR_APP_ID=

# Accountant builds are hosted locally by the unified Railway service by default.
# Override only if a separate accountant deployment is intentionally used.
SPPG_MAJA_ACCOUNTANT_URL=
SPPG_CEMPLANG_ACCOUNTANT_URL=

# Auth untuk endpoint /v1/gpt/*.
SPPG_GPT_API_KEY=

# Satu service account Google dipakai untuk Firestore + arsip Google Drive.
SPPG_GOOGLE_SERVICE_ACCOUNT_JSON=
SPPG_FIRESTORE_PROJECT_ID=sppg-finance-gpt

# Google Drive evidence archive
SPPG_DRIVE_ROOT_FOLDER_ID=
SPPG_DRIVE_RAW_CHAT_FOLDER_ID=
SPPG_DRIVE_PO_VENDOR_FOLDER_ID=
SPPG_DRIVE_ACCOUNTANT_FOLDER_ID=
SPPG_DRIVE_BGN_APPROVER_FOLDER_ID=
SPPG_DRIVE_KOPERASI_STOCK_FOLDER_ID=
SPPG_DRIVE_REVIEW_EXPORT_FOLDER_ID=
SPPG_DRIVE_BACKUP_FOLDER_ID=
